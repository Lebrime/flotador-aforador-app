# Variables de entorno
# Copiar este archivo a .env y configurar los valores

# Modo de depuración
DEBUG_MODE=false

# API URL (para futuras integraciones)
API_URL=http://localhost:3000

# Configuración de base de datos
DB_NAME=aforador.db
DB_VERSION=1.0

# Configuración de PDF
PDF_QUALITY=100

# Configuración de cronómetro
TIMER_PRECISION=10
